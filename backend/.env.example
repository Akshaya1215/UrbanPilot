# Copy this file to .env and fill in real values. Never commit the real .env.

# Google Gemini API key (free tier via Google AI Studio: https://aistudio.google.com/apikey)
# Optional for Agent 1 — if left blank, the agent falls back to a regex parser.
GOOGLE_API_KEY=

# Twilio credentials (from https://console.twilio.com, needed for the WhatsApp sandbox)
# Only needed by the webhook/UI layer, not by the agent itself.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
